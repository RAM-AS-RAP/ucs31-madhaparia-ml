# Preserve generated SVG exports; allow trailing spaces in their drawing instructions.
reports/candidate_model_comparison/figures/*.svg whitespace=-blank-at-eol

# Preserve exact bytes of fingerprinted calibration reports.
reports/candidate_calibration/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve exact bytes of fingerprinted final-evaluation reports.
reports/candidate_final_evaluation/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve exact bytes of runtime release records.
reports/candidate_runtime_bundle/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# These source identities were recorded with CRLF; preserve their exact bytes.
models/v2_feature_schema.json -text whitespace=cr-at-eol
docs/candidate_feature_schema_v1.json -text whitespace=cr-at-eol

# Keep the frozen matched-evaluation evidence byte-identical across checkouts.
reports/release_model_evaluation/** -text whitespace=cr-at-eol

# Preserve recorded offline artifacts and source-restoration provenance too.
reports/covid_research/*.json -text whitespace=cr-at-eol
reports/covid_research_final/*.json -text whitespace=cr-at-eol
reports/source-restoration.json -text whitespace=cr-at-eol
